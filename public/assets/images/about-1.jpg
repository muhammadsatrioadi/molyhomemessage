<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="b" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1C1C1C"/>
      <stop offset="100%" style="stop-color:#151515"/>
    </linearGradient>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#C9A96E"/>
      <stop offset="100%" style="stop-color:#E0C58A"/>
    </linearGradient>
    <radialGradient id="r1" cx="30%" cy="30%" r="50%">
      <stop offset="0%" style="stop-color:#C9A96E;stop-opacity:0.18"/>
      <stop offset="100%" style="stop-color:#C9A96E;stop-opacity:0"/>
    </radialGradient>
    <radialGradient id="r2" cx="80%" cy="75%" r="45%">
      <stop offset="0%" style="stop-color:#C9A96E;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#C9A96E;stop-opacity:0"/>
    </radialGradient>
  </defs>
  <rect width="1200" height="800" fill="url(#b)"/>
  <rect width="1200" height="800" fill="url(#r1)"/>
  <rect width="1200" height="800" fill="url(#r2)"/>
  <g opacity="0.07" stroke="url(#g)" stroke-width="1.5" fill="none">
    <path d="M100,500 Q400,300 700,450 T1200,400"/>
    <path d="M100,560 Q400,360 700,510 T1200,460"/>
    <path d="M100,620 Q400,420 700,570 T1200,520"/>
  </g>
  <g transform="translate(600,360)" text-anchor="middle">
    <circle r="150" fill="rgba(201,169,110,0.08)" stroke="rgba(201,169,110,0.22)" stroke-width="1.5"/>
    <circle r="100" fill="rgba(201,169,110,0.1)" stroke="rgba(201,169,110,0.28)" stroke-width="1.5"/>
    <text y="22" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="92" fill="url(#g)">✺</text>
  </g>
  <g transform="translate(600,620)" text-anchor="middle">
    <text font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="600" font-size="22" fill="#A7A7A7" letter-spacing="5">P R O F E S S I O N A L   •   T H E R A P E U T I C   •   C A L M</text>
  </g>
</svg>
