<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="b" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1C1C1C"/>
      <stop offset="100%" style="stop-color:#181818"/>
    </linearGradient>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#C9A96E"/>
      <stop offset="100%" style="stop-color:#E0C58A"/>
    </linearGradient>
    <radialGradient id="r" cx="30%" cy="35%" r="60%">
      <stop offset="0%" style="stop-color:#C9A96E;stop-opacity:0.2"/>
      <stop offset="100%" style="stop-color:#C9A96E;stop-opacity:0"/>
    </radialGradient>
  </defs>
  <rect width="800" height="500" fill="url(#b)"/>
  <rect width="800" height="500" fill="url(#r)"/>
  <g transform="translate(400,250)" text-anchor="middle">
    <circle r="120" fill="rgba(201,169,110,0.08)" stroke="rgba(201,169,110,0.22)" stroke-width="1.5"/>
    <circle r="80" fill="rgba(201,169,110,0.1)" stroke="rgba(201,169,110,0.28)" stroke-width="1.5"/>
    <text y="18" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="72" fill="url(#g)">❁</text>
  </g>
  <g transform="translate(400,430)" text-anchor="middle">
    <text font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="600" font-size="18" fill="#A7A7A7" letter-spacing="4">R E L A X A T I O N   •   W E L L B E I N G</text>
  </g>
</svg>
