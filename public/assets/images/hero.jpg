<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#121212"/>
      <stop offset="50%" style="stop-color:#1A1A1A"/>
      <stop offset="100%" style="stop-color:#1C1C1C"/>
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#C9A96E"/>
      <stop offset="100%" style="stop-color:#E0C58A"/>
    </linearGradient>
    <radialGradient id="glow1" cx="25%" cy="30%" r="50%">
      <stop offset="0%" style="stop-color:#C9A96E;stop-opacity:0.22"/>
      <stop offset="100%" style="stop-color:#C9A96E;stop-opacity:0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="80%" cy="75%" r="45%">
      <stop offset="0%" style="stop-color:#C9A96E;stop-opacity:0.12"/>
      <stop offset="100%" style="stop-color:#C9A96E;stop-opacity:0"/>
    </radialGradient>
  </defs>
  <rect width="1600" height="900" fill="url(#bg)"/>
  <rect width="1600" height="900" fill="url(#glow1)"/>
  <rect width="1600" height="900" fill="url(#glow2)"/>

  <g opacity="0.08" stroke="url(#gold)" stroke-width="1.5" fill="none">
    <ellipse cx="400" cy="450" rx="260" ry="150"/>
    <ellipse cx="400" cy="450" rx="300" ry="180"/>
    <ellipse cx="1200" cy="450" rx="220" ry="130"/>
    <ellipse cx="1200" cy="450" rx="260" ry="160"/>
  </g>

  <g transform="translate(800,420)" text-anchor="middle">
    <g transform="translate(0,-20)">
      <circle cx="-120" cy="0" r="62" fill="rgba(201,169,110,0.1)" stroke="rgba(201,169,110,0.25)" stroke-width="1.5"/>
      <text x="-120" y="8" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="42" fill="url(#gold)">✦</text>
    </g>
    <g transform="translate(0,0)">
      <circle cx="0" cy="0" r="90" fill="rgba(201,169,110,0.12)" stroke="url(#gold)" stroke-width="2"/>
      <text x="0" y="14" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="58" fill="url(#gold)">❁</text>
    </g>
    <g transform="translate(120,20)">
      <circle cx="0" cy="0" r="62" fill="rgba(201,169,110,0.1)" stroke="rgba(201,169,110,0.25)" stroke-width="1.5"/>
      <text x="0" y="8" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="42" fill="url(#gold)">✧</text>
    </g>
  </g>

  <g transform="translate(800,650)" text-anchor="middle">
    <text font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="700" font-size="28" fill="rgba(245,240,232,0.55)" letter-spacing="6">P R E M I U M   •   W E L L N E S S   •   R E L A X A T I O N</text>
  </g>

  <g transform="translate(800,760)" text-anchor="middle">
    <rect x="-160" y="-20" width="320" height="40" rx="20" fill="rgba(201,169,110,0.12)" stroke="rgba(201,169,110,0.35)"/>
    <text y="7" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="600" font-size="18" fill="url(#gold)" letter-spacing="3">KUALA LUMPUR  •  MALAYSIA</text>
  </g>
</svg>
