<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="b" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1C1C1C"/>
      <stop offset="100%" style="stop-color:#1D201C"/>
    </linearGradient>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#C9A96E"/>
      <stop offset="100%" style="stop-color:#E0C58A"/>
    </linearGradient>
    <radialGradient id="r" cx="50%" cy="45%" r="60%">
      <stop offset="0%" style="stop-color:#C9A96E;stop-opacity:0.15"/>
      <stop offset="100%" style="stop-color:#C9A96E;stop-opacity:0"/>
    </radialGradient>
  </defs>
  <rect width="800" height="500" fill="url(#b)"/>
  <rect width="800" height="500" fill="url(#r)"/>
  <g transform="translate(400,210)" text-anchor="middle">
    <circle r="88" fill="rgba(201,169,110,0.1)" stroke="rgba(201,169,110,0.25)" stroke-width="1.5"/>
    <circle r="60" fill="rgba(201,169,110,0.12)" stroke="rgba(201,169,110,0.3)" stroke-width="1.5"/>
    <text y="20" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="50" fill="url(#g)">✷</text>
  </g>
  <g transform="translate(400,370)" text-anchor="middle">
    <text font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="600" font-size="24" fill="#F5F0E8">Foot Massage Standard</text>
    <text y="40" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="16" fill="#A7A7A7" letter-spacing="3">60 • 90 • 120 MIN</text>
  </g>
</svg>
